# ===== NAI Gate 配置 =====
# 复制为 .env 后修改。所有变量均有默认值，只有前三项是必须设置的。

# 【必填】管理后台密码（/admin 登录用），务必改成强密码
ADMIN_PASSWORD=changeme-please

# 后台 Cookie 默认要求 HTTPS；HTTP 访问设为 0，重新创建容器生效。
# ADMIN_COOKIE_SECURE=1

# 【必填】NovelAI 持久 API Token（可多个，英文逗号分隔组成令牌池）
# 获取：novelai.net → 用户设置(User Settings) → Account → Get Persistent API Token
# 强烈建议使用公益站专用小号的 Token，不要用主号！
NAI_TOKENS=pst-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：按 NAI_TOKENS 的顺序设置初始图片费用策略。
# V5 日限额也可在管理面板「总览 → 上游令牌池」按 Token 修改；面板保存后优先于此环境变量，换序不影响。
# V5 日限额 0=不限；Anlas 1=允许、0=禁止。缺少的项使用这两个默认值。
# 例如：第一把不限，第二把只承接免费图，免费 V5 每天最多 150 张：
# NAI_TOKEN_V5_DAILY_LIMITS=0,150
# NAI_TOKEN_ALLOW_ANLAS=1,0

# Cookie/会话签名密钥（留空则首次启动自动生成并保存在 data/secret_key）
# SECRET_KEY=

# 数据目录（SQLite 数据库、公告、密钥文件）
# DATA_DIR=data

# 配额按天重置使用的时区
# TZ=Asia/Shanghai

# ---- 并发与限流 ----
# 全站同时打向 NovelAI 的最大请求数（单账号建议保持 1，太高会触发 429 甚至风控）
# GLOBAL_CONCURRENCY=1
# 每把虚拟 Key 的并发数
# KEY_CONCURRENCY=1
# 排队超时秒数
# QUEUE_TIMEOUT=90
# 每把普通用户 Key 的图片/标签任务最小间隔（秒）
# KEY_IMAGE_MIN_INTERVAL=15
# 每把上游 Token 各自的图片请求最小间隔（秒；图片和标签建议共用）
# IMAGE_MIN_INTERVAL=15
# 任一图片上游 429 后的全站最短冷却时间（秒；上游 Retry-After 更长时取更长者）
# IMAGE_429_COOLDOWN_SECONDS=60

# ---- Key 自动回收 ----
# 超过此天数没有任何通过鉴权的请求（从未使用则按创建时间算）会永久删除 Key；0=关闭。
# KEY_INACTIVITY_DELETE_DAYS=3

# ---- 图片安全钳制（默认开启）----
# 作用于未开通 Anlas 的普通 Key：单张 / 默认 ≤28 步 / 关闭 SMEA。
# V4.5 免费尺寸按像素面积 ≤1024x1024 判断；V5 按 Normal 预设边界判断。
# SAFE_CLAMP=1
# MAX_PIXELS=1048576
# MAX_STEPS=28
# 是否放开 img2img / 局部重绘（会消耗 Anlas，需要 Key 同时有 allow_anlas 权限）
# ALLOW_IMG2IMG=0

# ---- Anlas 供给 ----
# 全站月度 Anlas 预算（所有开通 Anlas 的 Key 共享的总闸，后台「设置」里可改）
# Opus Anlas 每月账单日回满到 10000（不叠加），建议预算留 20~30% 余量
# GLOBAL_MONTHLY_ANLAS=10000
# 全站每日免费 V5 张数上限，默认 150；官方余量在生成时按需查询。
# GLOBAL_DAILY_V5=150

# ---- 新 Key 的默认配额（后台可对每个 Key 单独覆盖）----
# V4.5 及以下免费图片每天最多 100 张；0=不限。
# DEFAULT_DAILY_IMAGES=100
# DEFAULT_DAILY_ANLAS=100
# DEFAULT_DAILY_V5=50
# DEFAULT_MONTHLY_ANLAS=2500
# DEFAULT_DAILY_TEXT_TOKENS=150000
# DEFAULT_RPM=10
# DEFAULT_KEY_EXPIRES_DAYS=30

# ---- 文本 ----
# 单次生成最大输出 tokens（钳制）
# MAX_TEXT_OUTPUT_TOKENS=300
# 单次输入最大字符数
# MAX_INPUT_CHARS=24000

# ---- 调试 ----
# 启动时自动创建一把演示 Key（打印在日志里）
# SEED_DEMO_KEY=0

# 跨域来源：英文逗号分隔；默认 *，空值关闭跨域中间件，不允许跨域 Cookie
# CORS_ORIGINS=*

# 上游地址（一般不用改）
# NAI_IMAGE_HOST=https://image.novelai.net
# NAI_TEXT_HOST=https://text.novelai.net
# NAI_TEXT_HOST_LEGACY=https://api.novelai.net
