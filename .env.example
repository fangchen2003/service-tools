# ===== NAI Gate 配置 =====
# 复制为 .env 后修改。所有变量均有默认值，只有前三项是必须设置的。

# 【必填】管理后台密码（/admin 登录用），务必改成强密码
ADMIN_PASSWORD=changeme-please

# 后台 Cookie 默认要求 HTTPS；HTTP 访问设为 0，重新创建容器生效。
# ADMIN_COOKIE_SECURE=1

# 【必填】NovelAI 持久 API Token（可多个，英文逗号分隔组成令牌池）
# 获取：novelai.net → 用户设置(User Settings) → Account → Get Persistent API Token
# 强烈建议使用公益站专用小号的 Token，不要用主号！
NAI_TOKENS=pst-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：按 NAI_TOKENS 的顺序设置初始图片费用策略。
# V5 日限额也可在管理面板「总览 → 上游令牌池」按 Token 修改；面板保存后优先于此环境变量，换序不影响。
# V5 日限额 0=不限；Anlas 1=允许、0=禁止。缺少的项使用这两个默认值。
# 例如：第一把不限，第二把只承接免费图，免费 V5 每天最多 150 张：
# NAI_TOKEN_V5_DAILY_LIMITS=0,150
# NAI_TOKEN_ALLOW_ANLAS=1,0

# Cookie/会话签名密钥（留空则首次启动自动生成并保存在 data/secret_key）
# SECRET_KEY=

# 数据目录（SQLite 数据库、公告、密钥文件）
# DATA_DIR=data

# 配额按天重置使用的时区
# TZ=Asia/Shanghai

# ---- 并发与限流 ----
# 全站同时打向 NovelAI 的最大请求数（单账号建议保持 1，太高会触发 429 甚至风控）
# GLOBAL_CONCURRENCY=1
# 每把虚拟 Key 的并发数
# KEY_CONCURRENCY=1
# 排队超时秒数
# QUEUE_TIMEOUT=90
# 每把普通用户 Key 的图片/标签任务最小间隔（秒）
# KEY_IMAGE_MIN_INTERVAL=15
# 每把上游 Token 各自的图片请求最小间隔（秒；图片和标签建议共用）
# IMAGE_MIN_INTERVAL=15
# 任一图片上游 429 后的全站最短冷却时间（秒；上游 Retry-After 更长时取更长者）
# IMAGE_429_COOLDOWN_SECONDS=60

# ---- Key 自动回收 ----
# 超过此天数没有任何通过鉴权的请求（从未使用则按创建时间算）会永久删除 Key；0=关闭。
# KEY_INACTIVITY_DELETE_DAYS=3

# ---- 图片安全钳制（默认开启）----
# 作用于未开通 Anlas 的普通 Key：单张 / 默认 ≤28 步 / 关闭 SMEA。
# V4.5 免费尺寸按像素面积 ≤1024x1024 判断；V5 按 Normal 预设边界判断。
# SAFE_CLAMP=1
# MAX_PIXELS=1048576
# MAX_STEPS=28
# 是否放开 img2img / 局部重绘（会消耗 Anlas，需要 Key 同时有 allow_anlas 权限）
# ALLOW_IMG2IMG=0

# ---- Anlas 供给 ----
# 全站月度 Anlas 预算（所有开通 Anlas 的 Key 共享的总闸，后台「设置」里可改）
# Opus Anlas 每月账单日回满到 10000（不叠加），建议预算留 20~30% 余量
# GLOBAL_MONTHLY_ANLAS=10000
# 全站每日免费 V5 张数上限，默认 150；官方余量在生成时按需查询。
# GLOBAL_DAILY_V5=150

# ---- 新 Key 的默认配额（后台可对每个 Key 单独覆盖）----
# V4.5 及以下免费图片每天最多 100 张；0=不限。
# DEFAULT_DAILY_IMAGES=100
# DEFAULT_DAILY_ANLAS=100
# DEFAULT_DAILY_V5=50
# DEFAULT_MONTHLY_ANLAS=2500
# DEFAULT_DAILY_TEXT_TOKENS=150000
# DEFAULT_RPM=10
# DEFAULT_KEY_EXPIRES_DAYS=30

# ---- 文本 ----
# 单次生成最大输出 tokens（钳制）
# MAX_TEXT_OUTPUT_TOKENS=300
# 单次输入最大字符数
# MAX_INPUT_CHARS=24000

# ---- 调试 ----
# 启动时自动创建一把演示 Key（打印在日志里）
# SEED_DEMO_KEY=0

# 跨域来源：英文逗号分隔；默认 *，空值关闭跨域中间件，不允许跨域 Cookie
# CORS_ORIGINS=*

# 上游地址（一般不用改）
# NAI_IMAGE_HOST=https://image.novelai.net
# NAI_TEXT_HOST=https://text.novelai.net
# NAI_TEXT_HOST_LEGACY=https://api.novelai.net

# ---- 上游防封与网络拟真 (Anti-Ban) ----
# 上游网络代理（支持 http://, https://, socks5://；让出站流量走海外原生住宅或独立干净出口 IP）
# UPSTREAM_PROXY=
# 自定义上游 User-Agent（留空时将自动从真实桌面 Chrome 128/129 指纹池为每把 Token 绑定固定指纹，含 Sec-CH-UA*）
# UPSTREAM_USER_AGENT=
# 是否启用 HTTP/2 握手与 ALPN 协商（默认 1，拟真真实浏览器网络指纹并自动回退）
# UPSTREAM_HTTP2=1
# 请求完成后的拟人化静默抖动延时（秒；消除 0ms 贴脸打桩特征，默认 1.0~3.0s）
# POST_REQUEST_JITTER_MIN=1.0
# POST_REQUEST_JITTER_MAX=3.0
# 单 Token 生图槽位严格串行化保护（1=无论并发如何设置，单 Token 同一时间严格只允许 1 个生图请求在途）
# SINGLE_IMAGE_SLOT_ENFORCED=0

# ---- Discord 自助领取 Key（可选；以下全部配置才会启用）----
# 用户在指定服务器输入 /register → 机器人调 /self-register/issue → Key 只在本人可见的回复里发（不走 OAuth、不私信）。
# 在 https://discord.com/developers/applications 创建应用；若要开放网页「用 Discord 登录」，OAuth2 Redirects 添加：<SITE_URL>/login/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# REGISTRATION_BRIDGE_SECRET=      # 随机长字符串，机器人与网关共用
# DISCORD_GUILD_ID=                # 发 /register 的服务器 ID
# DISCORD_ROLE_ID=                 # 可选：只有拥有该身份组的成员可领；留空则服务器任意成员可领
# SITE_URL=https://gate.example.com
# 自助领取的 Key 默认值（均不开 Anlas 权限）
# REGISTER_DAILY_IMAGES=30
# REGISTER_DAILY_V5=0
# REGISTER_IMAGE_SCOPE=legacy      # legacy=仅 V4.5 及以下；all=含 V5
# REGISTER_EXPIRES_DAYS=30         # 0=永不过期
# REGISTER_RPM=5
# REGISTER_FEATURES=image          # 新成员默认开通的功能：image,upscale,augment,vibe,tags,text,voice（逗号分隔）
# DISCORD_INVITE_URL=              # 可选：落地页上的「加入 Discord」按钮链接
# DISCORD_MEMBER_ROLE_ID=          # 可选：领到 Key 自动挂上此身份组，Key 到期/撤销自动摘除（机器人需「管理身份组」，且其角色排在 King 之下、该身份组之上）
# REGISTER_MIN_ACCOUNT_DAYS=7      # Discord 账号注册满多少天才能领取（防刷号抢名额）；0=不限
# ADMIN_DISCORD_IDS=              # 允许使用 /ops /revoke /ban 等管理命令的 Discord 用户 ID（逗号分隔）。留空则所有管理命令被拒绝
# REGISTER_MAX_USERS=10            # 同时持有 Key 的自助注册人数上限；0=不限
# REGISTER_RESET_AT=04:00          # 每天此时刻（按 TZ）清空全部自助注册用户，需重新 /register；留空=不清空

# ---- 告警（可选）：异常时通过 Discord 通知站长 ----
# 三选一。最简单：ALERT_USER_ID = 你的 Discord 用户 ID（需机器人已加入你们共同的服务器）。
# ALERT_USER_ID=
# 同一 Key 24 小时内来源网段数达到此值时私信提醒站长（防 Key 分享；0 = 只统计不提醒）
# KEY_SHARE_ALERT_NETS=3
# ALERT_CHANNEL_ID=
# ALERT_WEBHOOK_URL=
# ---- 生成记录（可选）：用于排查滥用；开启后会在 /register 私信、/help 和首页向成员披露 ----
# AUDIT_PROMPTS=0                  # 1=记录图片提示词
# AUDIT_THUMBS=0                   # 1=保存成功结果的小缩略图（约 20KB/张）
# AUDIT_RETENTION_DAYS=7           # 自动删除时间
# ---- 防爆破 ----
# AUTH_FAIL_MAX=20                 # 单 IP 在窗口内使用无效 Key 的次数上限，超过则临时拦截
# AUTH_FAIL_WINDOW=600
# AUTH_BLOCK_SECONDS=900
# ANNOUNCE_CHANNEL_ID=             # 给成员的公告频道（切换生成记录开关时机器人在此发测试期公告）
# USAGE_LOG_RETENTION_DAYS=90       # 用量明细日志保留天数（每日计数器和账本不受影响）
